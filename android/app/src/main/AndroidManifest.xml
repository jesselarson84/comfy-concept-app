<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only Android 8.0-9 (API 26-28) need this to save into Pictures/. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Batch 3, background runs: RunService is a foreground service (type
         dataSync: it follows a job on the PC) with a "Running N of M"
         notification (POST_NOTIFICATIONS, asked on Android 13+) and one
         vibration when the run ends (VIBRATE). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- No CAMERA permission on purpose: the camera button hands off to the
         system camera app (ACTION_IMAGE_CAPTURE), which needs no permission as
         long as this app does NOT declare CAMERA. See README-ANDROID.md. -->

    <!-- Package visibility (Android 11+): find the Tailscale app and camera apps. -->
    <queries>
        <package android:name="com.tailscale.ipn" />
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <!-- No analytics: opt out of WebView usage metrics and Safe Browsing lookups. -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="fullUser"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share -> Comfy Concept (one or several images; the first is used). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- Long-press launcher shortcut: "Change address". -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <service
            android:name=".RunService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Tiny in-house replacement for androidx FileProvider (AndroidX is not used).
             Serves cache/shared/ read-only (Share out) and cache/camera/ (camera capture). -->
        <provider
            android:name=".CacheFileProvider"
            android:authorities="app.jesse.comfyconcept.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
