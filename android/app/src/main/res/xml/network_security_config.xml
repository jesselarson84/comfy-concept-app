<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. Tailscale's *.ts.net certificates come from Let's Encrypt,
     which is in the system trust store. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
