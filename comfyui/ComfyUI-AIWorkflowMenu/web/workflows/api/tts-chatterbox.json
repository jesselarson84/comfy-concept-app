{
 "1": {
  "class_type": "ChatterboxTTS",
  "inputs": {
   "model_pack_name": "chatterbox",
   "text": "Hello. This is a short test.",
   "max_new_tokens": 400,
   "flow_cfg_scale": 0.7,
   "exaggeration": 0.5,
   "temperature": 0.8,
   "cfg_weight": 0.5,
   "repetition_penalty": 1.2,
   "min_p": 0.05,
   "top_p": 1,
   "seed": 1,
   "use_watermark": false,
   "device": "default",
   "dtype": "auto",
   "attention_mode": "sdpa",
   "top_k": 1000,
   "normalize_loudness": true,
   "num_steps": 10,
   "cfg_scale": 1,
   "enable_chunking": true,
   "max_chars_per_chunk": 400,
   "chunk_combination_method": "auto",
   "silence_between_chunks_ms": 100,
   "audio_prompt": [
    "3",
    0
   ]
  },
  "_meta": {
   "title": "Chatterbox TTS #prompt"
  }
 },
 "2": {
  "class_type": "SaveAudio",
  "inputs": {
   "audio": [
    "1",
    0
   ],
   "filename_prefix": "concept-app/tts_chatterbox"
  },
  "_meta": {
   "title": "Save Audio"
  }
 },
 "3": {
  "inputs": {
   "audio": "voice_sample.wav"
  },
  "class_type": "LoadAudio",
  "_meta": {
   "title": "Voice sample"
  }
 }
}
