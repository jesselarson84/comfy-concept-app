    "test:browser": "node --test \"test/browser/*.test.js\"",
    "icons": "node scripts/make-icons.js"
  },
  "dependencies": {},
  "devDependencies": {
    "playwright-core": "^1.50.0",
    "@sparticuz/chromium": "*"
  }
}
