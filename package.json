{
  "name": "comfy-concept-app",
  "version": "0.1.0",
  "description": "Phone/tablet PWA front-end for a local ComfyUI, for concepting (prompt -> images).",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node server/index.js",
    "mock": "node test/mock-comfy.js",
