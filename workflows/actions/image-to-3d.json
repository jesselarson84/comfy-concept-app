{
  "action": {
    "name": "Image to 3D",
    "verb": "Make a 3D model",
    "description": "Turn the image's main object into a 3D mesh (GLB file, shape only, no texture) with Hunyuan3D 2.1. Works best on a single object; the background is removed first. Takes a minute or two.",
    "output": "3d",
    "image": {
      "node": "2"
    },
    "params": {
      "steps": {
        "node": "7",
        "input": "steps",
        "type": "int",
        "min": 10,
        "max": 50,
        "default": 30,
        "label": "steps",
        "info": "How many refinement passes when building the shape. 30 is the default."
      },
      "detail": {
        "node": "8",
        "input": "octree_resolution",
        "type": "int",
        "min": 128,
        "max": 384,
        "default": 256,
        "label": "detail",
        "info": "Resolution of the 3D grid the surface is taken from. Higher captures finer detail but is slower."
      },
      "seed": {
        "node": "7",
        "input": "seed",
        "type": "int",
        "min": 0,
        "max": 4294967295,
        "default": 12345,
        "label": "seed",
        "info": "The random number the shape starts from; the same picture and seed give the same shape."
      }
    },
    "keywords": [
      "3-d",
      "3d",
      "glb",
      "mesh",
      "model it",
      "printable",
      "sculpt",
      "three-dimensional"
    ]
  },
  "workflow": {
    "1": {
      "class_type": "ImageOnlyCheckpointLoader",
      "inputs": {
        "ckpt_name": "hunyuan_3d_v2.1.safetensors"
      },
      "_meta": {
        "title": "Hunyuan3D 2.1"
      }
    },
    "2": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "example.png"
      },
      "_meta": {
        "title": "Object image #image"
      }
    },
    "20": {
      "class_type": "LoadBackgroundRemovalModel",
      "inputs": {
        "bg_removal_name": "birefnet.safetensors"
      }
    },
    "21": {
      "class_type": "RemoveBackground",
      "inputs": {
        "bg_removal_model": [
          "20",
          0
        ],
        "image": [
          "2",
          0
        ]
      }
    },
    "22": {
      "class_type": "InvertMask",
      "inputs": {
        "mask": [
          "21",
          0
        ]
      }
    },
    "23": {
      "class_type": "EmptyImage",
      "inputs": {
        "width": 64,
        "height": 64,
        "batch_size": 1,
        "color": 16777215
      }
    },
    "24": {
      "class_type": "ImageCompositeMasked",
      "inputs": {
        "destination": [
          "2",
          0
        ],
        "source": [
          "23",
          0
        ],
        "x": 0,
        "y": 0,
        "resize_source": true,
        "mask": [
          "22",
          0
        ]
      }
    },
    "3": {
      "class_type": "ModelSamplingAuraFlow",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "shift": 1.0,
        "sampling": "flow"
      },
      "_meta": {
        "title": "ModelSamplingAuraFlow"
      }
    },
    "13": {
      "class_type": "CLIPVisionEncode",
      "inputs": {
        "clip_vision": [
          "1",
          1
        ],
        "image": [
          "24",
          0
        ],
        "crop": "center"
      },
      "_meta": {
        "title": "CLIP Vision Encode"
      }
    },
    "6": {
      "class_type": "Hunyuan3Dv2Conditioning",
      "inputs": {
        "clip_vision_output": [
          "13",
          0
        ]
      },
      "_meta": {
        "title": "Hunyuan3D conditioning"
      }
    },
    "4": {
      "class_type": "EmptyLatentHunyuan3Dv2",
      "inputs": {
        "resolution": 4096,
        "batch_size": 1
      },
      "_meta": {
        "title": "Empty 3D latent"
      }
    },
    "7": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "3",
          0
        ],
        "seed": 12345,
        "steps": 30,
        "cfg": 5.0,
        "sampler_name": "euler",
        "scheduler": "normal",
        "positive": [
          "6",
          0
        ],
        "negative": [
          "6",
          1
        ],
        "latent_image": [
          "4",
          0
        ],
        "denoise": 1.0
      },
      "_meta": {
        "title": "Sampler #expose"
      }
    },
    "8": {
      "class_type": "VAEDecodeHunyuan3D",
      "inputs": {
        "samples": [
          "7",
          0
        ],
        "vae": [
          "1",
          2
        ],
        "num_chunks": 8000,
        "octree_resolution": 256
      },
      "_meta": {
        "title": "Decode to voxels #expose"
      }
    },
    "9": {
      "class_type": "VoxelToMesh",
      "inputs": {
        "voxel": [
          "8",
          0
        ],
        "algorithm": "surface net",
        "threshold": 0.6
      },
      "_meta": {
        "title": "Voxels to mesh"
      }
    },
    "10": {
      "class_type": "SaveGLB",
      "inputs": {
        "mesh": [
          "9",
          0
        ],
        "filename_prefix": "mesh"
      },
      "_meta": {
        "title": "Save GLB"
      }
    }
  }
}
