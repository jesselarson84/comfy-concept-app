{
  "action": {
    "name": "Upscale",
    "verb": "Upscale",
    "description": "Make an image bigger and sharper with an installed ESRGAN-type upscale model (4x model, then resized to the chosen factor). Use when the user wants it larger, higher-res, sharper, 'uprezzed'.",
    "output": "image",
    "image": {
      "node": "10"
    },
    "params": {
      "scale": {
        "node": "13",
        "input": "scale_by",
        "type": "number",
        "min": 1.5,
        "max": 4,
        "default": 2,
        "divideBy": 4,
        "label": "scale"
      },
      "model": {
        "node": "11",
        "input": "model_name",
        "type": "enum",
        "options": [
          "4x-UltraSharp.safetensors",
          "RealESRGAN_x4plus.safetensors",
          "4x-ClearRealityV1.safetensors",
          "4x_foolhardy_Remacri.pth"
        ],
        "default": "4x-UltraSharp.safetensors",
        "label": "model"
      }
    },
    "keywords": [
      "4k",
      "bigger",
      "enlarge",
      "higher res",
      "higher-res",
      "larger",
      "resolution",
      "sharper",
      "up-rez",
      "upres",
      "uprez",
      "upscale"
    ]
  },
  "workflow": {
    "10": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "example.png"
      },
      "_meta": {
        "title": "Image to upscale #image"
      }
    },
    "11": {
      "class_type": "UpscaleModelLoader",
      "inputs": {
        "model_name": "4x-UltraSharp.safetensors"
      },
      "_meta": {
        "title": "Upscale model #expose"
      }
    },
    "12": {
      "class_type": "ImageUpscaleWithModel",
      "inputs": {
        "upscale_model": [
          "11",
          0
        ],
        "image": [
          "10",
          0
        ]
      },
      "_meta": {
        "title": "Upscale 4x"
      }
    },
    "13": {
      "class_type": "ImageScaleBy",
      "inputs": {
        "image": [
          "12",
          0
        ],
        "upscale_method": "lanczos",
        "scale_by": 0.5
      },
      "_meta": {
        "title": "Resize to final scale #expose"
      }
    },
    "14": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "13",
          0
        ],
        "filename_prefix": "upscale"
      },
      "_meta": {
        "title": "Save"
      }
    }
  }
}
