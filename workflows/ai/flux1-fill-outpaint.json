{
 "preset": {
  "group": "Image",
  "label": "FLUX.1 Fill Outpaint (GGUF)",
  "menuPath": "Image/Outpainting/FLUX.1 Fill (GGUF)",
  "menuOrder": 1,
  "source": "Batch 14: FLUX.1 Fill dev Q5_K_S GGUF with ImagePadForOutpaint and Differential Diffusion.",
  "output": "image",
  "description": "Extends a picture past its edges: make a square shot wider, add sky above, more floor below. The new area is painted to match what is already there. Non-commercial license.",
  "params": {
   "left": {
    "node": "3",
    "input": "left",
    "type": "int",
    "min": 0,
    "max": 768,
    "step": 64,
    "default": 256,
    "label": "Left",
    "control": "stepper",
    "format": "px",
    "group": "Extend by",
    "info": "How far the picture grows on the left side, in pixels (after the picture is fitted to about 1 MP). 0 = that side stays as it is."
   },
   "right": {
    "node": "3",
    "input": "right",
    "type": "int",
    "min": 0,
    "max": 768,
    "step": 64,
    "default": 256,
    "label": "Right",
    "control": "stepper",
    "format": "px",
    "group": "Extend by",
    "info": "How far the picture grows on the right side, in pixels (after the picture is fitted to about 1 MP). 0 = that side stays as it is."
   },
   "top": {
    "node": "3",
    "input": "top",
    "type": "int",
    "min": 0,
    "max": 768,
    "step": 64,
    "default": 0,
    "label": "Top",
    "control": "stepper",
    "format": "px",
    "group": "Extend by",
    "info": "How far the picture grows on the top side, in pixels (after the picture is fitted to about 1 MP). 0 = that side stays as it is."
   },
   "bottom": {
    "node": "3",
    "input": "bottom",
    "type": "int",
    "min": 0,
    "max": 768,
    "step": 64,
    "default": 0,
    "label": "Bottom",
    "control": "stepper",
    "format": "px",
    "group": "Extend by",
    "info": "How far the picture grows on the bottom side, in pixels (after the picture is fitted to about 1 MP). 0 = that side stays as it is."
   },
   "feather": {
    "node": "3",
    "input": "feathering",
    "type": "int",
    "min": 0,
    "max": 128,
    "step": 8,
    "default": 32,
    "label": "Blend",
    "control": "slider",
    "format": "px",
    "info": "How far the new area fades into the edge of the old picture. Higher hides the seam better."
   },
   "steps": {
    "node": "20",
    "input": "steps",
    "type": "int",
    "min": 12,
    "max": 40,
    "default": 24,
    "label": "Steps",
    "control": "stepper",
    "info": "Refinement passes. FLUX.1 Fill is usually run at 20-30; fewer is faster but softer."
   },
   "guidance": {
    "node": "16",
    "input": "guidance",
    "type": "number",
    "min": 10,
    "max": 50,
    "step": 1,
    "default": 30,
    "label": "Guidance",
    "control": "slider",
    "info": "How closely the filled area follows the prompt. FLUX.1 Fill is made for high values (30 is the usual setting); lower lets it blend more freely with the picture."
   }
  },
  "maxBatch": 4,
  "vram": {
   "estMB": 9800,
   "basis": "weights: 7.7 GB Q5_K_S GGUF Fill UNet + T5 fp8 (4.9 GB, swapped out after encode) + activations at 1 MP plus the new area"
  },
  "info": {
   "prompt": "Describe the whole scene, including what the new area should show (\"a wide beach at sunset, palm trees on the left\").",
   "image": "The picture to extend. It is fitted to about 1 MP first; the sides then grow by the amounts in Settings."
  }
 },
 "workflow": {
  "1": {
   "inputs": {
    "image": "example.png"
   },
   "class_type": "LoadImage",
   "_meta": {
    "title": "Picture to extend #image"
   }
  },
  "2": {
   "inputs": {
    "image": [
     "1",
     0
    ],
    "upscale_method": "lanczos",
    "megapixels": 1,
    "resolution_steps": 16
   },
   "class_type": "ImageScaleToTotalPixels",
   "_meta": {
    "title": "Fit to 1 MP"
   }
  },
  "3": {
   "inputs": {
    "image": [
     "2",
     0
    ],
    "left": 256,
    "top": 0,
    "right": 256,
    "bottom": 0,
    "feathering": 32
   },
   "class_type": "ImagePadForOutpaint",
   "_meta": {
    "title": "Extend the canvas"
   }
  },
  "10": {
   "inputs": {
    "unet_name": "flux1-fill-dev-Q5_K_S.gguf"
   },
   "class_type": "UnetLoaderGGUF",
   "_meta": {
    "title": "Unet Loader (GGUF)"
   }
  },
  "11": {
   "inputs": {
    "clip_name1": "t5xxl_fp8_e4m3fn.safetensors",
    "clip_name2": "clip_l.safetensors",
    "type": "flux",
    "device": "default"
   },
   "class_type": "DualCLIPLoader",
   "_meta": {
    "title": "Load CLIP (Dual)"
   }
  },
  "12": {
   "inputs": {
    "vae_name": "ae.safetensors"
   },
   "class_type": "VAELoader",
   "_meta": {
    "title": "Load VAE"
   }
  },
  "15": {
   "inputs": {
    "text": "Describe the whole scene, including what should appear in the new area.",
    "clip": [
     "11",
     0
    ]
   },
   "class_type": "CLIPTextEncode",
   "_meta": {
    "title": "Prompt #prompt"
   }
  },
  "16": {
   "inputs": {
    "guidance": 30,
    "conditioning": [
     "15",
     0
    ]
   },
   "class_type": "FluxGuidance",
   "_meta": {
    "title": "FluxGuidance"
   }
  },
  "17": {
   "inputs": {
    "conditioning": [
     "15",
     0
    ]
   },
   "class_type": "ConditioningZeroOut",
   "_meta": {
    "title": "Conditioning Zero Out"
   }
  },
  "18": {
   "inputs": {
    "positive": [
     "16",
     0
    ],
    "negative": [
     "17",
     0
    ],
    "vae": [
     "12",
     0
    ],
    "pixels": [
     "3",
     0
    ],
    "mask": [
     "3",
     1
    ],
    "noise_mask": true
   },
   "class_type": "InpaintModelConditioning",
   "_meta": {
    "title": "Inpaint Conditioning"
   }
  },
  "19": {
   "inputs": {
    "model": [
     "10",
     0
    ],
    "strength": 1
   },
   "class_type": "DifferentialDiffusion",
   "_meta": {
    "title": "Differential Diffusion"
   }
  },
  "20": {
   "inputs": {
    "seed": 0,
    "steps": 24,
    "cfg": 1,
    "sampler_name": "euler",
    "scheduler": "simple",
    "denoise": 1,
    "model": [
     "19",
     0
    ],
    "positive": [
     "18",
     0
    ],
    "negative": [
     "18",
     1
    ],
    "latent_image": [
     "18",
     2
    ]
   },
   "class_type": "KSampler",
   "_meta": {
    "title": "KSampler"
   }
  },
  "21": {
   "inputs": {
    "samples": [
     "20",
     0
    ],
    "vae": [
     "12",
     0
    ]
   },
   "class_type": "VAEDecode",
   "_meta": {
    "title": "VAE Decode"
   }
  },
  "22": {
   "inputs": {
    "filename_prefix": "concept-app/flux1_outpaint",
    "images": [
     "21",
     0
    ]
   },
   "class_type": "SaveImage",
   "_meta": {
    "title": "Save Image"
   }
  }
 }
}
