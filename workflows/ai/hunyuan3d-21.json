   },
   "class_type": "ImageOnlyCheckpointLoader",
   "_meta": {
    "title": "Load Checkpoint Image Only (img2vid model)",
    "cnr_id": "comfy-core",
    "ver": "0.3.59"
   }
  },
  "19:3": {
   "inputs": {
    "shift": 1,
    "sampling": "flow",
    "model": [
     "19:1",
