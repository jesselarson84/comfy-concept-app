{
 "preset": {
  "group": "3D",
  "label": "Hunyuan3D 2.1 Image to Model",
  "menuPath": "3D/Hunyuan3D 2.1 Image to Model",
  "source": "ComfyUI-AIWorkflowMenu 3d/hunyuan3d_21_image_to_model.json (converted to API format with the ComfyUI 1.59.10 frontend)",
  "output": "3d",
  "description": "Untextured mesh (GLB) from one object picture. The background is removed first (BiRefNet), so a photo or render on any backdrop works. Same pipeline as the Chat 3D action.",
  "params": {
   "removeBg": {
    "node": "25",
    "input": "switch",
    "type": "enum",
    "options": [
     false,
     true
    ],
    "default": true,
    "label": "Remove background",
    "control": "seg",
    "labels": {
     "false": "Off",
     "true": "On"
    },
    "span2": true,
    "info": "Cuts the object out of its background first (BiRefNet), so a photo or render on any backdrop works. Turn it off only if the picture already shows the object on a plain background."
   },
   "steps": {
    "node": "19:7",
    "input": "steps",
    "type": "int",
    "min": 10,
    "max": 50,
    "default": 30,
    "label": "Steps",
    "control": "stepper",
    "step": 5,
    "info": "How many refinement passes when building the shape. 30 is the default; fewer is faster but less accurate."
   },
   "cfg": {
    "node": "19:7",
    "input": "cfg",
    "type": "number",
    "min": 1.0,
    "max": 10.0,
    "step": 0.5,
    "default": 5.0,
    "label": "Guidance",
    "control": "slider",
    "info": "How closely the shape follows the picture. 5 is the default; very high values can make the shape noisy."
   },
   "detail": {
    "node": "19:8",
    "input": "octree_resolution",
    "type": "enum",
    "options": [
     192,
     256,
     320,
     384
    ],
    "default": 256,
    "label": "Detail",
    "control": "select",
    "group": "Shape",
    "info": "Resolution of the 3D grid the surface is taken from. Higher captures finer detail but is slower and needs more memory."
   },
   "surface": {
    "node": "19:9",
    "input": "threshold",
    "type": "number",
    "min": 0.3,
    "max": 0.9,
    "step": 0.05,
    "default": 0.6,
    "label": "Surface level",
    "control": "slider",
    "info": "Where the surface is placed in the model's 3D density. Lower makes the shape fuller and thicker; higher makes it thinner and can open holes. 0.6 is the default."
   },
   "method": {
    "node": "19:9",
    "input": "algorithm",
    "type": "enum",
    "options": [
     "surface net",
     "basic"
    ],
    "default": "surface net",
    "label": "Surface method",
    "control": "select",
    "info": "How the 3D grid is turned into a mesh. \"surface net\" gives smooth surfaces; \"basic\" gives a blocky, voxel look."
   },
   "faces": {
    "node": "26",
    "input": "target_face_count",
    "type": "int",
    "min": 20000,
    "max": 520000,
    "step": 20000,
    "default": 520000,
    "label": "Max faces",
    "control": "slider",
    "format": "k",
    "zeroAtMax": true,
    "info": "Upper limit on the number of triangles; the mesh is simplified down to this. At the top of the slider (Full) nothing is removed."
   }
  },
  "maxBatch": 2,
  "vram": {
   "estMB": 9000,
   "basis": "weights: 7.4 GB checkpoint (DiT + VAE + DINO); octree 256 decode ~1-2 GB; BiRefNet background removal (~0.9 GB) runs first and can be offloaded before sampling"
  },
  "info": {
   "image": "A picture of one object (a photo or a render). The model builds an untextured 3D mesh of it."
  }
 },
 "workflow": {
  "2": {
   "inputs": {
    "image": "3d_hunyuan3d-v2.1_input_image.png"
   },
   "class_type": "LoadImage",
   "_meta": {
    "title": "Object image #image",
    "cnr_id": "comfy-core",
    "ver": "0.3.59"
   }
  },
  "20": {
   "inputs": {
    "bg_removal_name": "birefnet.safetensors"
   },
   "class_type": "LoadBackgroundRemovalModel",
   "_meta": {
    "title": "Load Background Removal Model",
    "cnr_id": "comfy-core",
    "ver": "0.3.59"
   }
  },
  "21": {
   "inputs": {
    "bg_removal_model": [
     "20",
     0
    ],
    "image": [
     "2",
     0
    ]
   },
   "class_type": "RemoveBackground",
   "_meta": {
    "title": "Remove Background",
    "cnr_id": "comfy-core",
    "ver": "0.3.59"
   }
  },
  "22": {
