    "batch_size": 1,
    "color": 16777215
   },
   "class_type": "EmptyImage",
   "_meta": {
    "title": "White",
    "cnr_id": "comfy-core",
    "ver": "0.3.59"
   }
  },
  "24": {
   "inputs": {
    "destination": [
     "2",
     0
    ],
    "source": [
     "23",
     0
    ],
    "x": 0,
    "y": 0,
    "resize_source": true,
    "mask": [
     "22",
     0
    ]
   },
   "class_type": "ImageCompositeMasked",
   "_meta": {
    "title": "Object on white",
    "cnr_id": "comfy-core",
    "ver": "0.3.59"
   }
  },
  "10": {
   "inputs": {
    "filename_prefix": "concept-app/hunyuan3d",
    "mesh": [
     "26",
     0
    ]
   },
   "class_type": "SaveGLB",
   "_meta": {
    "title": "Save 3D Model",
    "cnr_id": "comfy-core",
    "ver": "0.3.59"
   }
  },
  "19:1": {
