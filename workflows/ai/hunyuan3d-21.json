    ]
   },
   "class_type": "ModelSamplingAuraFlow",
   "_meta": {
    "title": "ModelSamplingAuraFlow",
    "cnr_id": "comfy-core",
    "ver": "0.3.59"
   }
  },
  "19:13": {
   "inputs": {
    "crop": "center",
    "clip_vision": [
     "19:1",
     1
    ],
    "image": [
     "25",
     0
    ]
   },
   "class_type": "CLIPVisionEncode",
   "_meta": {
    "title": "CLIP Vision Encode",
    "cnr_id": "comfy-core",
    "ver": "0.3.59"
   }
  },
  "19:6": {
   "inputs": {
    "clip_vision_output": [
     "19:13",
     0
    ]
   },
   "class_type": "Hunyuan3Dv2Conditioning",
   "_meta": {
    "title": "Hunyuan3Dv2Conditioning",
    "cnr_id": "comfy-core",
    "ver": "0.3.59"
   }
  },
  "19:4": {
   "inputs": {
    "resolution": 4096,
    "batch_size": 1
   },
   "class_type": "EmptyLatentHunyuan3Dv2",
   "_meta": {
    "title": "Empty Hunyuan 3D v2 Latent",
    "cnr_id": "comfy-core",
    "ver": "0.3.59"
   }
  },
  "19:7": {
   "inputs": {
    "seed": 952805179515179,
    "steps": 30,
    "cfg": 5,
    "sampler_name": "euler",
    "scheduler": "normal",
    "denoise": 1,
    "model": [
     "19:3",
     0
    ],
    "positive": [
     "19:6",
     0
    ],
    "negative": [
     "19:6",
     1
    ],
    "latent_image": [
     "19:4",
     0
    ]
   },
   "class_type": "KSampler",
   "_meta": {
    "title": "KSampler",
    "cnr_id": "comfy-core",
    "ver": "0.3.59"
   }
  },
  "19:8": {
   "inputs": {
    "num_chunks": 8000,
    "octree_resolution": 256,
    "samples": [
     "19:7",
     0
    ],
    "vae": [
     "19:1",
     2
    ]
   },
   "class_type": "VAEDecodeHunyuan3D",
   "_meta": {
    "title": "Hunyuan 3D VAE Decode",
    "cnr_id": "comfy-core",
    "ver": "0.3.59"
   }
  },
  "19:9": {
   "inputs": {
