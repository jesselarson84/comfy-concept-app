{
 "preset": {
  "group": "Image",
  "label": "FLUX.2 Klein 4B Text to Image",
  "menuPath": "Image/FLUX.2 Klein 4B Text to Image",
  "source": "ComfyUI-AIWorkflowMenu image/flux2_klein_4b_text_to_image.json (converted to API format with the ComfyUI 1.59.10 frontend)",
  "output": "image",
  "description": "FLUX.2 Klein 4B base model, real negative prompt, cfg 5. Slower than the 4-step distilled Klein, more control.",
  "size": {
   "base": [
    1024,
    1024
   ],
   "min": 512,
   "max": 1536,
   "multiple": 16
  },
  "params": {
   "steps": {
    "node": "75:62",
    "input": "steps",
    "type": "int",
    "min": 8,
    "max": 30,
    "default": 20,
    "label": "Steps",
    "control": "stepper",
    "info": "How many refinement passes. This preset uses the Klein 4B base model (not the 4-step distilled one), set up for about 20 steps. Fewer is faster but rougher."
   },
   "cfg": {
    "node": "75:63",
    "input": "cfg",
    "type": "number",
    "min": 1,
    "max": 8,
    "default": 5,
    "label": "Guidance",
    "control": "slider",
    "step": 0.5,
    "info": "How strictly the model follows the prompt and avoids the negative prompt (real CFG, which is why this preset has a negative prompt). 5 is the default; higher sticks closer to the words but can look harsh."
   },
   "sampler": {
    "node": "75:61",
    "input": "sampler_name",
    "type": "enum",
    "options": [
     "euler",
     "euler_ancestral",
     "dpmpp_2m",
     "res_multistep"
    ],
    "default": "euler",
    "label": "Sampler",
    "control": "select"
   }
  },
  "maxBatch": 8,
  "vram": {
   "estMB": 9000,
   "basis": "weights: 7.8 GB bf16 base UNet + Qwen3-4B encoder (swapped) + activations at 1 MP; cfg 5 doubles the batch"
  },
  "info": {
   "negative": "Things you do NOT want in the picture (for example: blurry, text, watermark). This preset uses real guidance (CFG 5), so the negative prompt does take effect when it is switched on."
  }
 },
