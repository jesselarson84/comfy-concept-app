{
 "preset": {
  "group": "Image",
  "label": "Qwen 2512 Text to Image",
  "menuPath": "Image/Qwen 2512 Text to Image",
  "source": "ComfyUI-AIWorkflowMenu image/qwen_2512_text_to_image.json (converted to API format with the ComfyUI 1.59.10 frontend)",
  "output": "image",
  "description": "Qwen-Image 2512 (fp8) with the 4-step Lightning LoRA. Strong text rendering and layouts.",
  "size": {
   "base": [
    1664,
    928
   ],
   "min": 512,
   "max": 1664,
   "multiple": 16
  },
  "params": {
   "lightning": {
    "node": "20",
    "input": "switch",
    "type": "enum",
    "options": [
     false,
     true
    ],
    "default": true,
    "label": "Lightning",
    "control": "seg",
    "labels": {
     "false": "Off",
     "true": "On"
    },
    "span2": true,
    "info": "Lightning is a speed-up add-on (a LoRA). On (the default): about 4 steps at guidance 1, a few seconds per image. Off: the full model, 20-50 steps; Guidance and the negative prompt only take effect when it is off."
   },
   "steps": {
    "node": "9",
    "input": "steps",
    "type": "int",
    "min": 2,
    "max": 50,
    "default": 4,
    "label": "Steps",
    "control": "stepper",
    "modes": {
     "param": "lightning",
     "values": {
      "true": {
       "min": 2,
       "max": 8,
       "default": 4
      },
      "false": {
       "min": 20,
       "max": 50,
       "default": 40
      }
     }
    },
    "info": "How many refinement passes. With Lightning on the range is 2-8 (4 is what it is made for); with Lightning off it is 20-50 (40 by default). More takes longer and rarely helps past that."
   },
   "cfg": {
    "node": "9",
    "input": "cfg",
    "type": "number",
    "min": 1.0,
    "max": 6.0,
    "step": 0.5,
    "default": 4.0,
    "label": "Guidance",
    "control": "slider",
    "when": {
     "param": "lightning",
     "is": false
    },
    "offValue": 1,
    "info": "How strictly the model follows the prompt and avoids the negative prompt. Only used with Lightning off; with Lightning on it runs at 1 and this is greyed out."
   },
   "shift": {
    "node": "3",
    "input": "shift",
    "type": "number",
    "min": 1.0,
    "max": 6.0,
    "step": 0.1,
    "default": 3.1,
    "label": "Shift",
    "control": "slider",
    "info": "How the model splits its effort between the overall layout and the fine detail; higher spends more of the steps on layout. 3.1 is this preset's default. Leave it unless you are experimenting."
   },
   "sampler": {
    "node": "9",
    "input": "sampler_name",
    "type": "enum",
    "options": [
     "euler",
     "res_multistep",
     "dpmpp_2m"
    ],
    "default": "euler",
    "label": "Sampler",
    "control": "select"
   },
   "scheduler": {
    "node": "9",
    "input": "scheduler",
    "type": "enum",
    "options": [
     "simple",
     "beta"
    ],
    "default": "simple",
    "label": "Scheduler",
    "control": "select"
   }
  },
  "maxBatch": 4,
  "vram": {
   "estMB": 21500,
   "basis": "weights: 20.4 GB fp8 UNet + 7B fp8 text encoder (offloaded after encode) + LoRA; peak while sampling ~20-21 GB"
  },
  "gguf": {
   "node": "1",
   "unet_name": "qwen-image-2512-Q5_K_M.gguf",
   "estMB": 16000,
   "basis": "14.3 GB Q5_K_M GGUF UNet (UnetLoaderGGUF) instead of the 20.4 GB fp8 + LoRA + activations; used on the small-GPU profile"
  },
  "info": {
   "prompt": "Describe the picture you want. Qwen-Image is strong at text and layouts: put any words that should appear in the picture in quotes.",
   "negative": "Things you do NOT want in the picture. Only takes effect with Lightning off (with Lightning on the model runs at guidance 1, which ignores it)."
  }
 },
 "workflow": {
  "1": {
   "inputs": {
    "unet_name": "qwen_image_2512_fp8_e4m3fn.safetensors",
    "weight_dtype": "default"
   },
   "class_type": "UNETLoader",
   "_meta": {
    "title": "Load Diffusion Model"
   }
  },
  "2": {
   "inputs": {
    "lora_name": "Qwen-Image-2512-Lightning-4steps-V1.0-fp32.safetensors",
    "strength_model": 1,
    "model": [
     "1",
     0
    ]
   },
   "class_type": "LoraLoaderModelOnly",
   "_meta": {
    "title": "Load LoRA"
   }
  },
  "3": {
   "inputs": {
    "shift": 3.1,
    "sampling": "flow",
    "model": [
     "20",
     0
    ]
   },
   "class_type": "ModelSamplingAuraFlow",
   "_meta": {
    "title": "ModelSamplingAuraFlow"
   }
  },
  "4": {
   "inputs": {
    "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors",
    "type": "qwen_image",
    "device": "default"
   },
   "class_type": "CLIPLoader",
   "_meta": {
    "title": "Load CLIP"
   }
  },
  "5": {
   "inputs": {
    "vae_name": "qwen_image_vae.safetensors"
   },
   "class_type": "VAELoader",
   "_meta": {
    "title": "Load VAE"
   }
  },
  "6": {
   "inputs": {
    "text": "Describe the image you want here.",
    "clip": [
     "4",
     0
    ]
   },
   "class_type": "CLIPTextEncode",
   "_meta": {
    "title": "Positive prompt #prompt"
   }
  },
  "7": {
   "inputs": {
    "text": "",
    "clip": [
     "4",
     0
    ]
   },
   "class_type": "CLIPTextEncode",
   "_meta": {
    "title": "Negative prompt #negative"
   }
  },
  "8": {
   "inputs": {
    "width": 1664,
    "height": 928,
    "batch_size": 1
   },
   "class_type": "EmptySD3LatentImage",
   "_meta": {
    "title": "EmptySD3LatentImage"
   }
  },
  "9": {
   "inputs": {
    "seed": 0,
    "steps": 4,
    "cfg": 1,
    "sampler_name": "euler",
    "scheduler": "simple",
    "denoise": 1,
    "model": [
     "3",
     0
    ],
    "positive": [
     "6",
     0
    ],
    "negative": [
     "7",
     0
    ],
    "latent_image": [
     "8",
     0
    ]
   },
   "class_type": "KSampler",
   "_meta": {
    "title": "KSampler"
   }
  },
  "10": {
   "inputs": {
    "samples": [
     "9",
     0
    ],
    "vae": [
     "5",
     0
    ]
   },
   "class_type": "VAEDecode",
   "_meta": {
    "title": "VAE Decode"
   }
  },
  "11": {
   "inputs": {
    "filename_prefix": "concept-app/qwen2512",
    "images": [
     "10",
     0
    ]
   },
   "class_type": "SaveImage",
   "_meta": {
    "title": "Save Image"
   }
  },
  "20": {
   "inputs": {
    "switch": true,
    "on_false": [
     "1",
     0
    ],
    "on_true": [
     "2",
     0
    ]
   },
   "class_type": "ComfySwitchNode",
   "_meta": {
    "title": "Lightning on/off"
   }
  }
 }
}