{
 "preset": {
  "group": "Image",
  "label": "Qwen Image Edit 2511",
  "menuPath": "Image/Image Edit/Qwen Image Edit 2511",
  "menuOrder": 3,
  "source": "ComfyUI Qwen-Image-Edit 2511 template (docs.comfy.org/tutorials/image/qwen/qwen-image-edit-2511), API format; Q5_K_M GGUF UNet + 2511 Lightning 4-step LoRA",
  "output": "image",
  "description": "Edit a picture with an instruction (Qwen-Image-Edit 2511, Q5_K_M GGUF, 4-step Lightning LoRA, cfg 1). Output follows the picture's shape.",
  "params": {
   "lightning": {
    "node": "20",
    "input": "switch",
    "type": "enum",
    "options": [
     false,
     true
    ],
    "default": true,
    "label": "Lightning",
    "control": "seg",
    "labels": {
     "false": "Off",
     "true": "On"
    },
    "span2": true,
    "info": "Lightning is a speed-up add-on (a LoRA). On (the default): about 4 steps at guidance 1, a few seconds per image. Off: the full model, 20-50 steps; Guidance and the negative prompt only take effect when it is off."
   },
   "steps": {
    "node": "10",
    "input": "steps",
    "type": "int",
    "min": 2,
    "max": 50,
    "default": 4,
    "label": "Steps",
    "control": "stepper",
    "modes": {
     "param": "lightning",
     "values": {
      "true": {
       "min": 2,
       "max": 8,
       "default": 4
      },
      "false": {
       "min": 20,
       "max": 50,
       "default": 40
      }
     }
    },
    "info": "How many refinement passes. With Lightning on the range is 2-8 (4 is what it is made for); with Lightning off it is 20-50 (40 by default). More takes longer and rarely helps past that."
   },
   "cfg": {
    "node": "10",
    "input": "cfg",
    "type": "number",
    "min": 1.0,
    "max": 6.0,
    "step": 0.5,
    "default": 4.0,
    "label": "Guidance",
    "control": "slider",
    "when": {
     "param": "lightning",
     "is": false
    },
    "offValue": 1,
    "info": "How strictly the model follows the prompt and avoids the negative prompt. Only used with Lightning off; with Lightning on it runs at 1 and this is greyed out."
   },
   "shift": {
    "node": "3",
    "input": "shift",
    "type": "number",
    "min": 1.0,
    "max": 6.0,
    "step": 0.1,
    "default": 3.1,
    "label": "Shift",
    "control": "slider",
    "info": "How the model splits its effort between the overall layout and the fine detail; higher spends more of the steps on layout. 3.1 is this preset's default. Leave it unless you are experimenting."
   },
   "sampler": {
    "node": "10",
    "input": "sampler_name",
    "type": "enum",
    "options": [
     "euler",
     "res_multistep",
     "dpmpp_2m"
    ],
    "default": "euler",
    "label": "Sampler",
    "control": "select"
   },
   "scheduler": {
    "node": "10",
    "input": "scheduler",
    "type": "enum",
    "options": [
     "simple",
     "beta"
    ],
    "default": "simple",
    "label": "Scheduler",
    "control": "select"
   }
  },
  "maxBatch": 4,
  "vram": {
   "estMB": 16000,
   "basis": "14.3 GB Q5_K_M GGUF UNet + 0.8 GB Lightning LoRA + 7B fp8 text encoder (offloaded after encode) + activations at ~1 MP"
  },
  "info": {
   "prompt": "The edit instruction: say what to change, in plain words (\"make the jacket red\", \"remove the people in the background\"). Things you do not mention should stay as they are.",
   "negative": "Things the edit should avoid. Only takes effect with Lightning off.",
   "image": "The picture to edit. The result follows its shape."
  }
 },
 "workflow": {
  "1": {
   "inputs": {
    "unet_name": "qwen-image-edit-2511-Q5_K_M.gguf"
   },
   "class_type": "UnetLoaderGGUF",
   "_meta": {
    "title": "Unet Loader (GGUF)"
   }
  },
  "2": {
   "inputs": {
    "lora_name": "Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors",
    "strength_model": 1,
    "model": [
     "1",
     0
    ]
   },
   "class_type": "LoraLoaderModelOnly",
   "_meta": {
    "title": "Lightning LoRA (2511)"
   }
  },
  "3": {
   "inputs": {
    "shift": 3.1,
    "sampling": "flow",
    "model": [
     "20",
     0
    ]
   },
   "class_type": "ModelSamplingAuraFlow",
   "_meta": {
    "title": "ModelSamplingAuraFlow"
   }
  },
  "13": {
   "inputs": {
    "strength": 1,
    "model": [
     "3",
     0
    ]
   },
   "class_type": "CFGNorm",
   "_meta": {
    "title": "CFGNorm"
   }
  },
  "4": {
   "inputs": {
    "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors",
    "type": "qwen_image",
    "device": "default"
   },
   "class_type": "CLIPLoader",
   "_meta": {
    "title": "Load CLIP"
   }
  },
  "5": {
   "inputs": {
    "vae_name": "qwen_image_vae.safetensors"
   },
   "class_type": "VAELoader",
   "_meta": {
    "title": "Load VAE"
   }
  },
  "6": {
   "inputs": {
    "image": "example.png"
   },
   "class_type": "LoadImage",
   "_meta": {
    "title": "Image to edit #image"
   }
  },
  "14": {
   "inputs": {
    "image": [
     "6",
     0
    ]
   },
   "class_type": "FluxKontextImageScale",
   "_meta": {
    "title": "Scale input"
   }
  },
  "7": {
   "inputs": {
    "prompt": "Describe the edit here.",
    "clip": [
     "4",
     0
    ],
    "vae": [
     "5",
     0
    ],
    "image1": [
     "14",
     0
    ]
   },
   "class_type": "TextEncodeQwenImageEditPlus",
   "_meta": {
    "title": "Edit instruction #prompt"
   }
  },
  "8": {
   "inputs": {
    "prompt": "",
    "clip": [
     "4",
     0
    ],
    "vae": [
     "5",
     0
    ],
    "image1": [
     "14",
     0
    ]
   },
   "class_type": "TextEncodeQwenImageEditPlus",
   "_meta": {
    "title": "Negative #negative"
   }
  },
  "15": {
   "inputs": {
    "conditioning": [
     "7",
     0
    ],
    "reference_latents_method": "index_timestep_zero"
   },
   "class_type": "FluxKontextMultiReferenceLatentMethod",
   "_meta": {
    "title": "Reference method (positive)"
   }
  },
  "16": {
   "inputs": {
    "conditioning": [
     "8",
     0
    ],
    "reference_latents_method": "index_timestep_zero"
   },
   "class_type": "FluxKontextMultiReferenceLatentMethod",
   "_meta": {
    "title": "Reference method (negative)"
   }
  },
  "9": {
   "inputs": {
    "pixels": [
     "14",
     0
    ],
    "vae": [
     "5",
     0
    ]
   },
   "class_type": "VAEEncode",
   "_meta": {
    "title": "VAE Encode"
   }
  },
  "10": {
   "inputs": {
    "seed": 0,
    "steps": 4,
    "cfg": 1,
    "sampler_name": "euler",
    "scheduler": "simple",
    "denoise": 1,
    "model": [
     "13",
     0
    ],
    "positive": [
     "15",
     0
    ],
    "negative": [
     "16",
     0
    ],
    "latent_image": [
     "9",
     0
    ]
   },
   "class_type": "KSampler",
   "_meta": {
    "title": "KSampler"
   }
  },
  "11": {
   "inputs": {
    "samples": [
     "10",
     0
    ],
    "vae": [
     "5",
     0
    ]
   },
   "class_type": "VAEDecode",
   "_meta": {
    "title": "VAE Decode"
   }
  },
  "12": {
   "inputs": {
    "filename_prefix": "concept-app/qwen_edit2511",
    "images": [
     "11",
     0
    ]
   },
   "class_type": "SaveImage",
   "_meta": {
    "title": "Save Image"
   }
  },
  "20": {
   "inputs": {
    "switch": true,
    "on_false": [
     "1",
     0
    ],
    "on_true": [
     "2",
     0
    ]
   },
   "class_type": "ComfySwitchNode",
   "_meta": {
    "title": "Lightning on/off"
   }
  }
 }
}