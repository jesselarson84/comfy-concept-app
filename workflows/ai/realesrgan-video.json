{
 "preset": {
  "group": "Video",
  "label": "Real-ESRGAN Video Upscale",
  "menuPath": "Video/Real-ESRGAN Video Upscale",
  "source": "ComfyUI-AIWorkflowMenu video/realesrgan_video_upscale.json (converted to API format with the ComfyUI 1.59.10 frontend)",
  "output": "video",
  "description": "Frame-by-frame 4x upscale of a clip with Real-ESRGAN.",
  "inputs": [
   {
    "kind": "video",
    "node": "9",
    "input": "file",
    "label": "Video to upscale"
   }
  ],
  "params": {
   "model": {
    "node": "1",
    "input": "model_name",
    "type": "enum",
    "options": [
     "RealESRGAN_x4plus.safetensors",
     "4x-UltraSharp.safetensors"
    ],
    "default": "RealESRGAN_x4plus.safetensors",
    "label": "Model",
    "control": "select",
    "labels": {
     "4x-UltraSharp.safetensors": "UltraSharp",
     "RealESRGAN_x4plus.safetensors": "RealESRGAN x4plus"
    },
    "info": "Which upscale model to use. RealESRGAN x4plus is a good all-rounder; UltraSharp keeps edges crisper."
   },
   "scale": {
    "node": "13",
    "input": "scale_by",
    "type": "enum",
    "options": [
     0.5,
     1.0
    ],
    "default": 0.5,
    "label": "Scale",
    "control": "seg",
    "labels": {
     "0.5": "2×",
     "1": "4×"
    },
    "info": "The model always enlarges 4×; 2× then shrinks that result by half (smaller file, still sharper than the original)."
   }
  },
  "maxBatch": 1,
  "vram": {
   "estMB": 2500,
   "basis": "64 MB model; all frames are held in RAM, VRAM ~1-3 GB"
  },
  "info": {
   "video": "The clip to upscale, frame by frame. The sound is kept."
  }
 },
 "workflow": {
  "1": {
   "inputs": {
    "model_name": "RealESRGAN_x4plus.safetensors"
   },
   "class_type": "UpscaleModelLoader",
   "_meta": {
    "title": "Load Upscale Model",
    "cnr_id": "comfy-core",
    "ver": "0.10.0"
   }
  },
  "2": {
   "inputs": {
    "upscale_model": [
     "1",
     0
    ],
    "image": [
     "10",
     0
    ]
   },
   "class_type": "ImageUpscaleWithModel",
   "_meta": {
    "title": "Upscale Image (using Model)",
    "cnr_id": "comfy-core",
    "ver": "0.10.0"
   }
  },
  "9": {
   "inputs": {
    "file": "gan_input.mp4"
   },
   "class_type": "LoadVideo",
   "_meta": {
    "title": "Load Video",
    "cnr_id": "comfy-core",
    "ver": "0.10.0"
   }
  },
  "10": {
   "inputs": {
    "video": [
     "9",
     0
    ]
   },
   "class_type": "GetVideoComponents",
   "_meta": {
    "title": "Get Video Components",
    "cnr_id": "comfy-core",
    "ver": "0.10.0"
   }
  },
  "11": {
   "inputs": {
    "fps": [
     "10",
     2
    ],
    "bit_depth": "auto",
    "color_space": "sRGB",
    "chroma_subsampling": "auto",
    "codec": "none",
    "images": [
     "13",
     0
    ],
    "audio": [
     "10",
     1
    ]
   },
   "class_type": "CreateVideo",
   "_meta": {
    "title": "Create Video",
    "cnr_id": "comfy-core",
    "ver": "0.10.0"
   }
  },
  "12": {
   "inputs": {
    "filename_prefix": "concept-app/realesrgan_video",
    "format": "auto",
    "format.codec": "auto",
    "codec": "auto",
    "video": [
     "11",
     0
    ]
   },
   "class_type": "SaveVideo",
   "_meta": {
    "title": "Save Video",
    "cnr_id": "comfy-core",
    "ver": "0.10.0"
   }
  },
  "13": {
   "inputs": {
    "upscale_method": "lanczos",
    "scale_by": 0.5,
    "image": [
     "2",
     0
    ]
   },
   "class_type": "ImageScaleBy",
   "_meta": {
    "title": "2x / 4x"
   }
  }
 }
}