{
 "preset": {
  "group": "Image",
  "label": "SeedVR2 7B Image Upscale",
  "menuPath": "Image/SeedVR2 7B Image Upscale",
  "source": "ComfyUI-AIWorkflowMenu image/seedvr2_7b_image_upscale.json (converted to API format with the ComfyUI 1.59.10 frontend); ImageCompare node removed",
  "output": "image",
  "description": "Diffusion upscaler (SeedVR2 7B int8). Restores detail; 2x by default (menu default 4x is heavy on 11 GB).",
  "params": {
   "scale": {
    "node": "66:57",
    "input": "resize_type.multiplier",
    "type": "number",
    "min": 1,
    "max": 4,
    "default": 2,
    "label": "Scale",
    "control": "slider",
    "step": 0.5,
    "format": "x"
   },
   "colorFix": {
    "node": "66:59",
    "input": "color_correction_method",
    "type": "enum",
    "options": [
     "none",
     "lab",
     "wavelet",
     "adain"
    ],
    "default": "none",
    "label": "Color fix",
    "control": "select"
   },
   "tile": {
    "node": "66:48",
    "input": "tile_size",
    "type": "enum",
    "options": [
     256,
     384,
     512,
     768,
     1024
    ],
    "default": 512,
    "label": "VAE tile",
    "control": "select",
    "also": [
     {
      "node": "66:55",
      "input": "tile_size"
     }
    ],
    "group": "Memory"
   }
  },
  "maxBatch": 2,
  "vram": {
   "estMB": 10500,
   "basis": "weights: 8.2 GB int8 7B DiT + 0.5 GB VAE; tiled VAE keeps activations small; grows with output size"
  }
 },
