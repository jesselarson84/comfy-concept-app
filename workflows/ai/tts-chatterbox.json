{
 "preset": {
  "group": "Audio",
  "label": "Chatterbox TTS",
  "menuPath": "Audio/Chatterbox TTS",
  "source": "authored from /object_info (ChatterboxTTS + SaveAudio); pack pinned to the installed \"chatterbox\"",
  "output": "audio",
  "description": "English text to speech with the built-in Chatterbox voice. 25 tokens ~ 1 s.",
  "params": {
   "voice": {
    "node": "1",
    "input": "model_pack_name",
    "type": "enum",
    "options": [
     "chatterbox",
     "chatterbox-turbo",
     "chatterbox-multilingual-es-mx-latam",
     "chatterbox-multilingual-es-es",
     "chatterbox-multilingual-pt-br",
     "chatterbox-multilingual-pt-pt",
     "chatterbox-multilingual-hi",
     "chatterbox-multilingual-zh-cmn"
    ],
    "default": "chatterbox",
    "label": "Voice model",
    "control": "select",
    "labels": {
     "chatterbox": "Chatterbox (English)",
     "chatterbox-turbo": "Chatterbox Turbo",
     "chatterbox-multilingual-es-mx-latam": "Multilingual · Spanish (LatAm)",
     "chatterbox-multilingual-es-es": "Multilingual · Spanish (Spain)",
     "chatterbox-multilingual-pt-br": "Multilingual · Portuguese (BR)",
     "chatterbox-multilingual-pt-pt": "Multilingual · Portuguese (PT)",
     "chatterbox-multilingual-hi": "Multilingual · Hindi",
     "chatterbox-multilingual-zh-cmn": "Multilingual · Mandarin"
    },
    "span2": true,
    "installed": {
     "folder": "chatterbox",
     "prefix": "{v}/"
    },
    "info": "Which Chatterbox model to use: English, Turbo, or a multilingual model for another language. Only models installed on the PC are listed."
   },
   "seconds": {
    "node": "1",
    "input": "max_new_tokens",
    "type": "int",
    "min": 3,
    "max": 80,
    "default": 16,
    "label": "Max length",
    "control": "slider",
    "format": "s",
    "multiplyBy": 25,
    "info": "Upper limit on how long the speech may be (about 25 tokens per second). Raise it if the end of a long text is cut off."
   },
   "exaggeration": {
    "node": "1",
    "input": "exaggeration",
    "type": "number",
    "min": 0.25,
    "max": 2,
    "default": 0.5,
    "label": "Expressiveness",
    "control": "slider",
    "step": 0.05,
    "info": "How expressive and emotional the voice is. 0.5 is neutral; higher is more dramatic (and tends to speak faster)."
   },
   "cfg_weight": {
    "node": "1",
    "input": "cfg_weight",
    "type": "number",
    "min": 0.2,
    "max": 1,
    "default": 0.5,
    "label": "Pace / adherence",
    "control": "slider",
    "step": 0.05,
    "when": {
     "param": "voice",
     "notIn": [
      "chatterbox-turbo"
     ]
    },
    "info": "Pacing and how closely it sticks to the voice. Lower gives slower, more deliberate speech; 0.5 is the default. Not used by Chatterbox Turbo."
   },
   "temperature": {
    "node": "1",
    "input": "temperature",
    "type": "number",
    "min": 0.05,
    "max": 2,
    "default": 0.8,
    "label": "Temperature",
    "control": "slider",
    "step": 0.05,
    "info": "How much variation goes into the voice. Lower is steadier and more predictable; higher is livelier but can wobble."
   },
   "repetition": {
    "node": "1",
    "input": "repetition_penalty",
    "type": "number",
    "min": 1.0,
    "max": 2.0,
    "step": 0.1,
    "default": 1.2,
    "label": "Repetition penalty",
    "control": "slider",
    "info": "Discourages repeating the same sounds or words. Raise it a little if the speech stutters or loops."
   },
   "normalize": {
    "node": "1",
    "input": "normalize_loudness",
    "type": "enum",
    "options": [
     false,
     true
    ],
    "default": true,
    "label": "Normalize loudness",
    "control": "seg",
    "labels": {
     "false": "Off",
     "true": "On"
    },
    "info": "Evens out the loudness of the result so it is not too quiet or too loud."
   },
   "pause": {
    "node": "1",
    "input": "silence_between_chunks_ms",
    "type": "int",
    "min": 0,
    "max": 500,
    "default": 100,
    "label": "Chunk pause (ms)",
    "control": "stepper",
    "step": 25,
    "info": "Silence put between the chunks a long text is split into, in milliseconds."
   }
  },
  "maxBatch": 4,
  "files": [
   {
    "folder": "chatterbox",
    "file": "chatterbox/t3_cfg.safetensors"
   },
   {
    "folder": "chatterbox",
    "file": "chatterbox/s3gen.safetensors"
   },
   {
    "folder": "chatterbox",
    "file": "chatterbox/ve.safetensors"
   }
  ],
  "vram": {
   "estMB": 3500,
   "basis": "weights: 2.0 GB T3 + 1.0 GB S3Gen fp32"
  },
  "inputs": [
   {
    "kind": "audio",
    "node": "3",
    "input": "audio",
    "label": "Voice sample",
    "optional": true
   }
  ],
  "optional": [
   {
    "node": "3",
    "drop": [
     {
      "node": "1",
      "input": "audio_prompt"
     }
    ]
   }
  ],
  "info": {
   "prompt": "The text to speak. Long texts are split into chunks and read one after another.",
   "audio": "Optional: a few seconds of clean speech to copy the voice from. Leave empty to use the built-in voice."
  }
 },
 "workflow": {
  "1": {
   "class_type": "ChatterboxTTS",
   "inputs": {
    "model_pack_name": "chatterbox",
    "text": "Hello. This is a short test.",
    "max_new_tokens": 400,
    "flow_cfg_scale": 0.7,
    "exaggeration": 0.5,
    "temperature": 0.8,
    "cfg_weight": 0.5,
    "repetition_penalty": 1.2,
    "min_p": 0.05,
    "top_p": 1.0,
    "seed": 1,
    "use_watermark": false,
    "device": "default",
    "dtype": "auto",
    "attention_mode": "sdpa",
    "top_k": 1000,
    "normalize_loudness": true,
    "num_steps": 10,
    "cfg_scale": 1.0,
    "enable_chunking": true,
    "max_chars_per_chunk": 400,
    "chunk_combination_method": "auto",
    "silence_between_chunks_ms": 100,
    "audio_prompt": [
     "3",
     0
    ]
   },
   "_meta": {
    "title": "Chatterbox TTS #prompt"
   }
  },
  "2": {
   "class_type": "SaveAudio",
   "inputs": {
    "audio": [
     "1",
     0
    ],
    "filename_prefix": "concept-app/tts_chatterbox"
   },
   "_meta": {
    "title": "Save Audio"
   }
  },
  "3": {
   "inputs": {
    "audio": "voice_sample.wav"
   },
   "class_type": "LoadAudio",
   "_meta": {
    "title": "Voice sample"
   }
  }
 }
}