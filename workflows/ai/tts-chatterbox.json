{
 "preset": {
  "group": "Audio",
  "label": "Chatterbox TTS",
  "menuPath": "Audio/Chatterbox TTS",
  "source": "authored from /object_info (ChatterboxTTS + SaveAudio); pack pinned to the installed \"chatterbox\"",
  "output": "audio",
  "description": "English text to speech with the built-in Chatterbox voice. 25 tokens ~ 1 s.",
  "params": {
   "length": {
    "node": "1",
    "input": "max_new_tokens",
    "type": "int",
    "min": 64,
    "max": 2000,
    "default": 400,
    "label": "Max length (tokens)"
   },
   "exaggeration": {
    "node": "1",
    "input": "exaggeration",
    "type": "number",
    "min": 0.25,
    "max": 2,
    "default": 0.5,
    "label": "Expressiveness"
   },
   "cfg_weight": {
    "node": "1",
    "input": "cfg_weight",
    "type": "number",
    "min": 0.2,
    "max": 1,
    "default": 0.5,
    "label": "Pace / adherence"
   },
   "temperature": {
    "node": "1",
    "input": "temperature",
    "type": "number",
    "min": 0.05,
    "max": 2,
    "default": 0.8,
    "label": "Temperature"
   }
  },
  "maxBatch": 4,
  "files": [
   {
    "folder": "chatterbox",
    "file": "chatterbox/t3_cfg.safetensors"
   },
   {
    "folder": "chatterbox",
    "file": "chatterbox/s3gen.safetensors"
   },
   {
    "folder": "chatterbox",
    "file": "chatterbox/ve.safetensors"
   }
  ],
  "vram": {
   "estMB": 3500,
   "basis": "weights: 2.0 GB T3 + 1.0 GB S3Gen fp32"
  }
 },
 "workflow": {
  "1": {
   "class_type": "ChatterboxTTS",
   "inputs": {
    "model_pack_name": "chatterbox",
    "text": "Hello. This is a short test.",
    "max_new_tokens": 400,
    "flow_cfg_scale": 0.7,
    "exaggeration": 0.5,
    "temperature": 0.8,
    "cfg_weight": 0.5,
    "repetition_penalty": 1.2,
    "min_p": 0.05,
    "top_p": 1.0,
    "seed": 1,
    "use_watermark": false,
    "device": "default",
    "dtype": "auto",
    "attention_mode": "sdpa",
    "top_k": 1000,
    "normalize_loudness": true,
    "num_steps": 10,
    "cfg_scale": 1.0,
    "enable_chunking": true,
    "max_chars_per_chunk": 400,
    "chunk_combination_method": "auto",
    "silence_between_chunks_ms": 100
   },
   "_meta": {
    "title": "Chatterbox TTS #prompt"
   }
  },
  "2": {
   "class_type": "SaveAudio",
   "inputs": {
    "audio": [
     "1",
     0
    ],
    "filename_prefix": "concept-app/tts_chatterbox"
   },
   "_meta": {
    "title": "Save Audio"
   }
  }
 }
}