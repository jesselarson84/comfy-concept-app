    "control": "slider",
    "step": 4,
    "format": "frames",
    "info": "Length of the clip in frames (the readout shows the seconds at the chosen FPS). Longer clips take much longer and need more memory."
   },
   "steps": {
    "node": "3",
    "input": "steps",
    "type": "int",
    "min": 10,
    "max": 30,
    "default": 20,
    "label": "Steps",
    "control": "stepper",
    "info": "How many refinement passes. 20 is the default for Wan 2.2 5B; fewer is faster but rougher."
   },
   "fps": {
    "node": "57",
    "input": "fps",
    "type": "enum",
    "options": [
     16,
     24
    ],
    "default": 24,
    "label": "FPS",
    "control": "seg",
    "info": "Frames per second of the saved video. The same frames are made either way: 24 plays them at normal speed (the model's native rate), 16 plays them slower and longer."
   },
   "cfg": {
    "node": "3",
    "input": "cfg",
    "type": "number",
    "min": 1.0,
    "max": 8.0,
    "step": 0.5,
    "default": 5.0,
    "label": "Guidance",
    "control": "slider",
    "info": "How strictly the video follows the prompt and avoids the negative prompt. 5 is the default."
   },
   "shift": {
    "node": "48",
    "input": "shift",
    "type": "number",
    "min": 1.0,
    "max": 12.0,
    "step": 0.5,
    "default": 8.0,
    "label": "Shift",
    "control": "slider",
    "info": "How the model splits its effort between the overall layout and motion and the fine detail. 8 is this preset's default; leave it unless you are experimenting."
   },
   "sampler": {
    "node": "3",
    "input": "sampler_name",
    "type": "enum",
    "options": [
     "uni_pc",
     "euler",
     "dpmpp_2m"
    ],
    "default": "uni_pc",
    "label": "Sampler",
    "control": "select",
    "info": "The method used to take each step. uni_pc is the default this preset was set up with."
   },
   "scheduler": {
    "node": "3",
    "input": "scheduler",
    "type": "enum",
    "options": [
     "simple",
     "beta"
    ],
    "default": "simple",
    "label": "Scheduler",
    "control": "select"
   }
  },
  "maxBatch": 1,
  "vram": {
   "estMB": 14000,
