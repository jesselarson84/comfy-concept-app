{
 "preset": {
  "kind": "workflow",
  "group": "Concept",
  "label": "Concept Looks (Depth Pass)",
  "menuPath": "Concept/Concept Looks (Depth Pass)",
  "menuOrder": 2,
  "source": "Comfy UI Ideas doc, ControlNet Concept Iteration (authored). Z-Image Turbo + Z-Image-Turbo-Fun-Controlnet-Union 2.1 (alibaba-pai).",
  "output": "image",
  "description": "Same as Concept Looks (Edges), but guided by a depth pass (or a gray / AO pass) rendered out of Cinema 4D or Redshift: the exact spatial layout, without copying the greybox surfaces.",
  "params": {
   "strength": {
    "node": "12",
    "input": "strength",
    "type": "number",
    "min": 0.3,
    "max": 1.2,
    "step": 0.05,
    "default": 0.8,
    "label": "Follow layout",
    "control": "slider",
    "info": "How strictly the picture follows the render. Too high copies the greybox too literally (flat grey surfaces); too low and the layout drifts. 0.65-0.9 is the usual range."
   },
   "release": {
    "node": "12",
    "input": "end_percent",
    "type": "number",
    "min": 0.4,
    "max": 1,
    "step": 0.05,
    "default": 1,
    "label": "Release at",
    "control": "slider",
    "info": "When the layout guide lets go, as a share of the steps. 1 = guided to the end. Lower (0.6-0.8) lets the last steps add free detail and texture on top of the fixed layout."
   },
   "patch": {
    "node": "11",
    "input": "name",
    "type": "enum",
    "options": [
     "Z-Image-Turbo-Fun-Controlnet-Union-2.1-2602-8steps.safetensors",
     "Z-Image-Turbo-Fun-Controlnet-Union-2.1-lite-2602-8steps.safetensors"
    ],
    "default": "Z-Image-Turbo-Fun-Controlnet-Union-2.1-2602-8steps.safetensors",
    "label": "ControlNet",
    "control": "seg",
    "labels": {
     "Z-Image-Turbo-Fun-Controlnet-Union-2.1-2602-8steps.safetensors": "Full",
     "Z-Image-Turbo-Fun-Controlnet-Union-2.1-lite-2602-8steps.safetensors": "Lite"
    },
    "info": "Full (6.7 GB) follows the layout more closely. Lite (2 GB) is lighter on memory and a bit looser, so it suits higher \"Follow layout\" values."
   },
   "steps": {
    "node": "13",
    "input": "steps",
    "type": "int",
    "min": 6,
    "max": 12,
    "default": 8,
    "label": "Steps",
    "control": "stepper",
    "info": "Refinement passes. The model and the ControlNet are made for 8."
   }
  },
  "maxBatch": 8,
  "vram": {
   "estMB": 20500,
   "basis": "Z-Image Turbo bf16 12.3 GB + ControlNet patch 6.7 GB (2 GB lite); ComfyUI keeps what does not fit on the GPU in system RAM"
  },
  "info": {
   "image": "A depth pass (white near, black far) or a gray / AO pass from Cinema 4D or Redshift. A dedicated pass gives tighter control than letting the model guess depth.",
   "prompt": "The look: materials, lighting and mood, e.g. \"broadcast studio set, brushed steel, warm LED strips, glossy black floor, haze\". Ten variations of one camera angle: raise Batch."
  }
 },
 "workflow": {
  "1": {
   "inputs": {
    "unet_name": "z_image_turbo_bf16.safetensors",
    "weight_dtype": "default"
   },
   "class_type": "UNETLoader",
   "_meta": {
    "title": "Load Diffusion Model"
   }
  },
  "2": {
   "inputs": {
    "clip_name": "qwen_3_4b.safetensors",
    "type": "lumina2",
    "device": "default"
   },
   "class_type": "CLIPLoader",
   "_meta": {
    "title": "Load CLIP"
   }
  },
  "3": {
   "inputs": {
    "vae_name": "ae.safetensors"
   },
   "class_type": "VAELoader",
   "_meta": {
    "title": "Load VAE"
   }
  },
  "4": {
   "inputs": {
    "shift": 3,
    "sampling": "flow",
    "model": [
     "1",
     0
    ]
   },
   "class_type": "ModelSamplingAuraFlow",
   "_meta": {
    "title": "ModelSamplingAuraFlow"
   }
  },
  "5": {
   "inputs": {
    "text": "",
    "clip": [
     "2",
     0
    ]
   },
   "class_type": "CLIPTextEncode",
   "_meta": {
    "title": "Look #prompt"
   }
  },
  "6": {
   "inputs": {
    "conditioning": [
     "5",
     0
    ]
   },
   "class_type": "ConditioningZeroOut",
   "_meta": {
    "title": "Conditioning Zero Out"
   }
  },
  "7": {
   "inputs": {
    "image": "example.png"
   },
   "class_type": "LoadImage",
   "_meta": {
    "title": "Depth or gray pass #image"
   }
  },
  "8": {
   "inputs": {
    "image": [
     "7",
     0
    ],
    "upscale_method": "lanczos",
    "megapixels": 1,
    "resolution_steps": 16
   },
   "class_type": "ImageScaleToTotalPixels",
   "_meta": {
    "title": "Fit to 1 MP"
   }
  },
  "9": {
   "inputs": {
    "image": [
     "8",
     0
    ]
   },
   "class_type": "GetImageSize",
   "_meta": {
    "title": "Size"
   }
  },
  "10": {
   "inputs": {
    "width": [
     "9",
     0
    ],
    "height": [
     "9",
     1
    ],
    "batch_size": 1
   },
   "class_type": "EmptySD3LatentImage",
   "_meta": {
    "title": "Latent (same shape as the render)"
   }
  },
  "11": {
   "inputs": {
    "name": "Z-Image-Turbo-Fun-Controlnet-Union-2.1-2602-8steps.safetensors"
   },
   "class_type": "ModelPatchLoader",
   "_meta": {
    "title": "Load ControlNet (model patch)"
   }
  },
  "12": {
   "inputs": {
    "model": [
     "4",
     0
    ],
    "model_patch": [
     "11",
     0
    ],
    "vae": [
     "3",
     0
    ],
    "strength": 0.75,
    "image": [
     "8",
     0
    ],
    "start_percent": 0,
    "end_percent": 1
   },
   "class_type": "ZImageFunControlnet",
   "_meta": {
    "title": "Z-Image Fun ControlNet"
   }
  },
  "13": {
   "inputs": {
    "seed": 0,
    "steps": 8,
    "cfg": 1,
    "sampler_name": "res_multistep",
    "scheduler": "simple",
    "denoise": 1,
    "model": [
     "12",
     0
    ],
    "positive": [
     "5",
     0
    ],
    "negative": [
     "6",
     0
    ],
    "latent_image": [
     "10",
     0
    ]
   },
   "class_type": "KSampler",
   "_meta": {
    "title": "KSampler"
   }
  },
  "14": {
   "inputs": {
    "samples": [
     "13",
     0
    ],
    "vae": [
     "3",
     0
    ]
   },
   "class_type": "VAEDecode",
   "_meta": {
    "title": "VAE Decode"
   }
  },
  "15": {
   "inputs": {
    "filename_prefix": "concept-app/concept_depth",
    "images": [
     "14",
     0
    ]
   },
   "class_type": "SaveImage",
   "_meta": {
    "title": "Save Image"
   }
  }
 }
}
