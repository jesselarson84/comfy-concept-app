{
 "preset": {
  "kind": "workflow",
  "group": "Concept",
  "label": "Concept Looks (Qwen-Image)",
  "menuPath": "Concept/Concept Looks (Qwen-Image)",
  "menuOrder": 5,
  "source": "Batch 14: Qwen-Image 2512 fp8 + Lightning 4-step LoRA + InstantX Qwen-Image-ControlNet-Union; guides from Canny, Depth Anything 3 or DWPose.",
  "output": "image",
  "description": "Keeps the layout of a render or photo and changes the look from the prompt, with Qwen-Image 2512: very good at following long prompts and at lettering. Guide by edges, depth, a depth pass or a person's pose. Needs an RTX 30 series or newer GPU (on an RTX 2080 Ti the pictures come out black).",
  "params": {
   "guide": {
    "node": "40",
    "input": "value",
    "type": "enum",
    "options": [
     "edges",
     "depth",
     "pass",
     "pose"
    ],
    "default": "edges",
    "label": "Guide by",
    "control": "seg",
    "span2": true,
    "labels": {
     "edges": "Edges",
     "depth": "Depth",
     "pass": "Depth pass",
     "pose": "Pose"
    },
    "set": {
     "edges": [
      {
       "node": "30",
       "input": "switch",
       "value": false
      },
      {
       "node": "31",
       "input": "switch",
       "value": false
      },
      {
       "node": "32",
       "input": "switch",
       "value": false
      }
     ],
     "pass": [
      {
       "node": "30",
       "input": "switch",
       "value": true
      },
      {
       "node": "31",
       "input": "switch",
       "value": false
      },
      {
       "node": "32",
       "input": "switch",
       "value": false
      }
     ],
     "depth": [
      {
       "node": "31",
       "input": "switch",
       "value": true
      },
      {
       "node": "32",
       "input": "switch",
       "value": false
      }
     ],
     "pose": [
      {
       "node": "32",
       "input": "switch",
       "value": true
      }
     ]
    },
    "info": "What the picture keeps from your render or photo. Edges: outlines and panel lines (canny). Depth: the shapes and distances, worked out with Depth Anything 3. Depth pass: the picture already is a depth pass (white near) from Cinema 4D or Redshift. Pose: a person's pose (DWPose), so a figure keeps its stance in a new look."
   },
   "strength": {
    "node": "42",
    "input": "strength",
    "type": "number",
    "min": 0.3,
    "max": 1.2,
    "step": 0.05,
    "default": 0.9,
    "label": "Follow layout",
    "control": "slider",
    "info": "How strictly the picture follows the guide. 0.8-1.0 is the usual range for this ControlNet; lower lets the look drift further from the render."
   },
   "release": {
    "node": "42",
    "input": "end_percent",
    "type": "number",
    "min": 0.4,
    "max": 1,
    "step": 0.05,
    "default": 1,
    "label": "Release at",
    "control": "slider",
    "info": "When the guide lets go, as a share of the steps. With only 4 steps, values below 0.75 release after the first steps."
   },
   "detail": {
    "node": "20",
    "input": "low_threshold",
    "type": "number",
    "min": 0.05,
    "max": 0.6,
    "step": 0.05,
    "default": 0.2,
    "label": "Edge detail",
    "control": "slider",
    "when": {
     "param": "guide",
     "is": "edges"
    },
    "info": "Edges only: which edges count. Lower picks up fine panel lines and texture edges; higher keeps only the strong silhouettes."
   }
  },
  "maxBatch": 4,
  "vram": {
   "estMB": 24500,
   "basis": "Qwen-Image 2512 fp8 20.4 GB + InstantX ControlNet 3.3 GB + 7B fp8 text encoder (offloaded after encode); ComfyUI keeps what does not fit on the GPU in system RAM"
  },
  "info": {
   "image": "A frame from Cinema 4D (greybox or rough Redshift lighting), a depth pass, or a photo of a person for Pose. Its shape (fitted to about 1 MP) is the shape of the result.",
   "prompt": "The look: materials, lighting and mood, e.g. \"broadcast studio set, brushed steel, warm LED strips, glossy black floor, haze\". Ten variations of one camera angle: raise Batch."
  },
  "needs": {
   "bf16": true,
   "why": "Needs an RTX 30 series or newer GPU: the InstantX ControlNet computes in bfloat16, and on older cards (like the RTX 2080 Ti) every picture comes out black."
  }
 },
 "workflow": {
  "1": {
   "inputs": {
    "unet_name": "qwen_image_2512_fp8_e4m3fn.safetensors",
    "weight_dtype": "default"
   },
   "class_type": "UNETLoader",
   "_meta": {
    "title": "Load Diffusion Model"
   }
  },
  "2": {
   "inputs": {
    "lora_name": "Qwen-Image-2512-Lightning-4steps-V1.0-fp32.safetensors",
    "strength_model": 1,
    "model": [
     "1",
     0
    ]
   },
   "class_type": "LoraLoaderModelOnly",
   "_meta": {
    "title": "Load LoRA (Lightning 4 steps)"
   }
  },
  "3": {
   "inputs": {
    "shift": 3.1,
    "sampling": "flow",
    "model": [
     "2",
     0
    ]
   },
   "class_type": "ModelSamplingAuraFlow",
   "_meta": {
    "title": "ModelSamplingAuraFlow"
   }
  },
  "4": {
   "inputs": {
    "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors",
    "type": "qwen_image",
    "device": "default"
   },
   "class_type": "CLIPLoader",
   "_meta": {
    "title": "Load CLIP"
   }
  },
  "5": {
   "inputs": {
    "text": "",
    "clip": [
     "4",
     0
    ]
   },
   "class_type": "CLIPTextEncode",
   "_meta": {
    "title": "Look #prompt"
   }
  },
  "6": {
   "inputs": {
    "text": "",
    "clip": [
     "4",
     0
    ]
   },
   "class_type": "CLIPTextEncode",
   "_meta": {
    "title": "Negative (empty)"
   }
  },
  "7": {
   "inputs": {
    "image": "example.png"
   },
   "class_type": "LoadImage",
   "_meta": {
    "title": "Render or photo #image"
   }
  },
  "8": {
   "inputs": {
    "image": [
     "7",
     0
    ],
    "upscale_method": "lanczos",
    "megapixels": 1,
    "resolution_steps": 16
   },
   "class_type": "ImageScaleToTotalPixels",
   "_meta": {
    "title": "Fit to 1 MP"
   }
  },
  "12": {
   "inputs": {
    "vae_name": "qwen_image_vae.safetensors"
   },
   "class_type": "VAELoader",
   "_meta": {
    "title": "Load VAE"
   }
  },
  "13": {
   "inputs": {
    "image": [
     "8",
     0
    ]
   },
   "class_type": "GetImageSize",
   "_meta": {
    "title": "Size"
   }
  },
  "14": {
   "inputs": {
    "width": [
     "13",
     0
    ],
    "height": [
     "13",
     1
    ],
    "batch_size": 1
   },
   "class_type": "EmptySD3LatentImage",
   "_meta": {
    "title": "Latent (same shape as the render)"
   }
  },
  "17": {
   "inputs": {
    "seed": 0,
    "steps": 4,
    "cfg": 1,
    "sampler_name": "euler",
    "scheduler": "simple",
    "denoise": 1,
    "model": [
     "3",
     0
    ],
    "positive": [
     "42",
     0
    ],
    "negative": [
     "42",
     1
    ],
    "latent_image": [
     "14",
     0
    ]
   },
   "class_type": "KSampler",
   "_meta": {
    "title": "KSampler"
   }
  },
  "18": {
   "inputs": {
    "samples": [
     "17",
     0
    ],
    "vae": [
     "12",
     0
    ]
   },
   "class_type": "VAEDecode",
   "_meta": {
    "title": "VAE Decode"
   }
  },
  "19": {
   "inputs": {
    "filename_prefix": "concept-app/concept_qwen",
    "images": [
     "18",
     0
    ]
   },
   "class_type": "SaveImage",
   "_meta": {
    "title": "Save Image"
   }
  },
  "20": {
   "inputs": {
    "image": [
     "8",
     0
    ],
    "low_threshold": 0.2,
    "high_threshold": 0.5
   },
   "class_type": "Canny",
   "_meta": {
    "title": "Edges (canny)"
   }
  },
  "21": {
   "inputs": {
    "model_name": "depth_anything_3_base.safetensors",
    "weight_dtype": "default"
   },
   "class_type": "LoadDA3Model",
   "_meta": {
    "title": "Load Depth Anything 3"
   }
  },
  "22": {
   "inputs": {
    "da3_model": [
     "21",
     0
    ],
    "image": [
     "8",
     0
    ],
    "resolution": 1008,
    "resize_method": "upper_bound_resize",
    "mode": "mono"
   },
   "class_type": "DA3Inference",
   "_meta": {
    "title": "Depth Anything 3"
   }
  },
  "23": {
   "inputs": {
    "da3_geometry": [
     "22",
     0
    ],
    "output": "depth",
    "output.normalization": "v2_style",
    "output.apply_sky_clip": false
   },
   "class_type": "DA3Render",
   "_meta": {
    "title": "Depth (white near)"
   }
  },
  "24": {
   "inputs": {
    "image": [
     "8",
     0
    ],
    "detect_hand": "enable",
    "detect_body": "enable",
    "detect_face": "enable",
    "resolution": 1024,
    "bbox_detector": "yolox_l.onnx",
    "pose_estimator": "dw-ll_ucoco_384.onnx",
    "scale_stick_for_xinsr_cn": "disable"
   },
   "class_type": "DWPreprocessor",
   "_meta": {
    "title": "Pose (DWPose)"
   }
  },
  "30": {
   "inputs": {
    "switch": false,
    "on_false": [
     "20",
     0
    ],
    "on_true": [
     "8",
     0
    ]
   },
   "class_type": "ComfySwitchNode",
   "_meta": {
    "title": "Edges or depth pass"
   }
  },
  "31": {
   "inputs": {
    "switch": false,
    "on_false": [
     "30",
     0
    ],
    "on_true": [
     "23",
     0
    ]
   },
   "class_type": "ComfySwitchNode",
   "_meta": {
    "title": "or estimated depth"
   }
  },
  "32": {
   "inputs": {
    "switch": false,
    "on_false": [
     "31",
     0
    ],
    "on_true": [
     "24",
     0
    ]
   },
   "class_type": "ComfySwitchNode",
   "_meta": {
    "title": "or pose"
   }
  },
  "40": {
   "inputs": {
    "value": "edges"
   },
   "class_type": "PrimitiveString",
   "_meta": {
    "title": "Guide by (setting)"
   }
  },
  "41": {
   "inputs": {
    "control_net_name": "Qwen-Image-InstantX-ControlNet-Union.safetensors"
   },
   "class_type": "ControlNetLoader",
   "_meta": {
    "title": "Load ControlNet (InstantX Union)"
   }
  },
  "42": {
   "inputs": {
    "positive": [
     "5",
     0
    ],
    "negative": [
     "6",
     0
    ],
    "control_net": [
     "41",
     0
    ],
    "image": [
     "32",
     0
    ],
    "strength": 0.9,
    "start_percent": 0,
    "end_percent": 1,
    "vae": [
     "12",
     0
    ]
   },
   "class_type": "ControlNetApplyAdvanced",
   "_meta": {
    "title": "Apply ControlNet"
   }
  }
 }
}
