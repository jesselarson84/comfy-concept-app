{
 "preset": {
  "kind": "workflow",
  "group": "VFX",
  "label": "Flipbook Sheet",
  "menuPath": "VFX/Flipbook Sheet",
  "menuOrder": 1,
  "source": "Comfy UI Ideas doc, VFX Sprites and Grunge Maps: flipbook sprite sheets, route 1 (Wan video, frames tiled). Graph from the Wan 2.2 5B preset.",
  "output": "image",
  "description": "Smoke, fire, dust or sparks as a flipbook texture sheet for Unreal particle materials: a short Wan 2.2 clip on black, evenly spaced frames tiled into a grid. Use it additive, or remove the black.",
  "promptFormat": {
   "template": "Close-up VFX element: {text}. Large, filling most of the frame, it grows and changes shape over time, full life cycle from start to end. Isolated on a pure black background, centered, static locked-off camera, no camera movement."
  },
  "size": {
   "base": [
    704,
    704
   ],
   "min": 480,
   "max": 1024,
   "multiple": 32
  },
  "params": {
   "grid": {
    "node": "70",
    "input": "num_frames",
    "also": [
     {
      "node": "72",
      "input": "values.a"
     }
    ],
    "type": "enum",
    "options": [
     16,
     36,
     64
    ],
    "default": 16,
    "label": "Sheet",
    "control": "seg",
    "labels": {
     "16": "4Ã—4",
     "36": "6Ã—6",
     "64": "8Ã—8"
    },
    "info": "How many frames go into the sheet (a square grid). More frames play smoother but each one is smaller in the texture."
   },
   "cell": {
    "node": "73",
    "input": "cell_width",
    "also": [
     {
      "node": "73",
      "input": "cell_height"
     }
    ],
    "type": "enum",
    "options": [
     128,
     256,
     512
    ],
    "default": 256,
    "label": "Frame size",
    "control": "seg",
    "labels": {
     "128": "128",
     "256": "256",
     "512": "512"
    },
    "format": "px",
    "info": "Size of each frame in the sheet. 4Ã—4 at 256 gives a 1024 sheet; 8Ã—8 at 256 a 2048 sheet."
   },
   "frames": {
    "node": "55",
    "input": "length",
    "type": "int",
    "min": 33,
    "max": 121,
    "default": 81,
    "label": "Length",
    "control": "slider",
    "step": 4,
    "format": "frames",
    "info": "Length of the clip the frames are picked from. Longer clips show more of the motion (a whole puff of smoke) but take longer to make."
   },
   "steps": {
    "node": "3",
    "input": "steps",
    "type": "int",
    "min": 10,
    "max": 30,
    "default": 20,
    "label": "Steps",
    "control": "stepper",
    "info": "How many refinement passes. 20 is the default for Wan 2.2 5B; fewer is faster but rougher."
   },
   "cfg": {
    "node": "3",
    "input": "cfg",
    "type": "number",
    "min": 1,
    "max": 8,
    "step": 0.5,
    "default": 5,
    "label": "Guidance",
    "control": "slider",
    "info": "How strictly the video follows the prompt and avoids the negative prompt. 5 is the default."
   },
   "shift": {
    "node": "48",
    "input": "shift",
    "type": "number",
    "min": 1,
    "max": 12,
    "step": 0.5,
    "default": 8,
    "label": "Shift",
    "control": "slider",
    "info": "How the model splits its effort between the overall layout and motion and the fine detail. 8 is this preset's default; leave it unless you are experimenting."
   }
  },
  "maxBatch": 1,
  "vram": {
   "estMB": 14000,
   "basis": "weights: 10 GB fp16 5B model + 6.7 GB umt5 fp8 (swapped) + video latents (Comfy docs: fits 8 GB with offload)"
  },
  "optional": [
   {
    "node": "60",
    "drop": [
     {
      "node": "55",
      "input": "start_image"
     }
    ]
   }
  ],
  "info": {
   "prompt": "The effect: \"thick white smoke puff rising and dissipating\", \"campfire flames\", \"dust burst\". Black background and a still camera are added for you.",
   "image": "Optional first frame, e.g. a still of the effect to animate."
  }
 },
