{
 "preset": {
  "kind": "workflow",
  "group": "Textures",
  "label": "Grunge Map",
  "menuPath": "Textures/Grunge Map",
  "menuOrder": 4,
  "source": "Comfy UI Ideas doc, VFX Sprites and Grunge Maps: grunge, scratch and stain maps (authored)",
  "output": "image",
  "description": "Seamless grayscale mask (grunge, scratches, stains, noise) to drive roughness or dirt blends in Unreal. Z-Image Turbo, then the seam fix, grayscale and a contrast push.",
  "promptFormat": {
   "template": "{text}, dense high-contrast grunge pattern filling the entire frame edge to edge, black and white, seamless tileable texture, top-down flat scan, even lighting, no objects"
  },
  "size": {
   "base": [
    1024,
    1024
   ],
   "min": 512,
   "max": 2048,
   "multiple": 16
  },
  "params": {
   "contrast": {
    "node": "52",
    "input": "factor",
    "type": "number",
    "min": 1,
    "max": 2,
    "step": 0.1,
    "default": 1.4,
    "label": "Contrast",
    "control": "slider",
    "format": "x",
    "info": "How hard the grays are pushed toward black and white. Higher gives a cleaner mask for blends; lower keeps soft in-between values."
   },
   "blend": {
    "node": "39",
    "input": "denoise",
    "type": "number",
    "min": 0.5,
    "max": 1,
    "step": 0.05,
    "default": 0.8,
    "label": "Seam repaint",
    "control": "slider",
    "info": "How much the seam cross is repainted when the map is made tileable. 0.8 blends the join while keeping the grain; 1 repaints it completely and can come out flatter."
   },
   "steps": {
    "node": "8",
    "input": "steps",
    "also": [
     {
      "node": "39",
      "input": "steps"
     }
    ],
    "type": "int",
    "min": 4,
    "max": 12,
    "default": 8,
    "label": "Steps",
    "control": "stepper",
    "info": "Refinement passes. Z-Image Turbo is made for about 8."
   }
  },
  "maxBatch": 8,
  "vram": {
   "estMB": 15800,
   "basis": "Z-Image Turbo bf16 at 1 MP + 2 GB lite ControlNet patch for the seam pass"
  },
  "files": [
   {
    "folder": "model_patches",
    "file": "Z-Image-Turbo-Fun-Controlnet-Union-2.1-lite-2602-8steps.safetensors"
   }
  ],
  "info": {
   "prompt": "What kind of grunge: \"concrete stains\", \"fine scratches\", \"rust patches\", \"dust and dirt\". The words for a flat, tileable black-and-white mask are added for you."
  }
 },
