{
 "preset": {
  "kind": "workflow",
  "group": "Textures",
  "label": "Make Seamless",
  "menuPath": "Textures/Make Seamless",
  "menuOrder": 3,
  "source": "Comfy UI Ideas doc, Texture Cleanup and Prep: seamless tiling (half offset + seam inpaint, authored)",
  "output": "image",
  "description": "Makes a texture tile: shifts it by half so the edges meet in the middle, fixes that cross (AI repaint with Z-Image Turbo, or a soft blend), and shifts it back. The rest of the picture is untouched.",
  "promptDefault": "seamless continuous texture, same material, same pattern and scale, flat lighting",
  "params": {
   "size": {
    "node": "8",
    "input": "longer_edge",
    "type": "enum",
    "options": [
     1024,
     2048
    ],
    "default": 1024,
    "label": "Working size",
    "control": "seg",
    "labels": {
     "1024": "1K",
     "2048": "2K"
    },
    "info": "Size of the long side while the seam is repainted, and of the result. 2K keeps more detail but takes about four times as long."
   },
   "method": {
    "node": "62",
    "input": "switch",
    "type": "enum",
    "options": [
     false,
     true
    ],
    "default": true,
    "label": "Seam fix",
    "control": "seg",
    "labels": {
     "false": "Blend",
     "true": "AI repaint"
    },
    "span2": true,
    "info": "How the seam cross is fixed. AI repaint redraws it with Z-Image so shapes carry on across the seam: best for bricks, planks, tiles, anything with structure. Blend fades the original over the seam with a soft mask: instant, no AI, best for noise-like surfaces (concrete, dirt, grunge), where a repaint can come out flat."
   },
   "blend": {
    "node": "45",
    "input": "denoise",
    "type": "number",
    "min": 0.5,
    "max": 1,
    "step": 0.05,
    "default": 1,
    "label": "Repaint strength",
    "control": "slider",
    "when": {
     "param": "method",
     "is": true
    },
    "info": "How much of the seam cross is redrawn. 1 redraws it completely so shapes join up cleanly; lower keeps more of the original there but can leave a faint line."
   },
   "steps": {
    "node": "45",
    "input": "steps",
    "type": "int",
    "min": 4,
    "max": 12,
    "default": 8,
    "label": "Steps",
    "control": "stepper",
    "when": {
     "param": "method",
     "is": true
    },
    "info": "Refinement passes for the seam repaint. Z-Image Turbo is made for about 8."
   }
  },
  "maxBatch": 4,
  "vram": {
   "estMB": 15800,
   "basis": "Z-Image Turbo bf16 + 2 GB lite ControlNet patch (inpaint) at the working size"
  },
  "files": [
   {
    "folder": "model_patches",
    "file": "Z-Image-Turbo-Fun-Controlnet-Union-2.1-lite-2602-8steps.safetensors"
   }
  ],
  "info": {
   "image": "The texture to make tileable. Square power-of-two textures work best; other shapes are kept.",
   "prompt": "Optional: what the material is (\"mossy cobblestones\"). Helps the repainted seam match. Leave empty for a neutral instruction."
  }
 },
