{
 "preset": {
  "kind": "workflow",
  "group": "3D Assets",
  "label": "Photo to 3D Model",
  "menuPath": "3D Assets/Photo to 3D Model",
  "menuOrder": 1,
  "source": "Batch 8 (1123 Change List): Qwen Image Edit 2511 clean-up (as Remove Lighting) feeding the Hunyuan3D 2.1 preset.",
  "output": "3d",
  "description": "A phone photo of an object in, an untextured 3D model (GLB) out. The photo is cleaned up first (Qwen Image Edit 2511: lighting and shadows removed, the object alone on a plain background), then Hunyuan3D 2.1 builds the mesh.",
  "promptDefault": "keep the object exactly as it is",
  "promptFormat": {
   "template": "{text}. Show only this one object, whole and centered, on a plain white background. Remove the background, other objects, shadows, highlights and reflections: even, diffuse lighting from every side. Keep exactly the same shape, proportions, colours and details."
  },
  "params": {
   "cleanup": {
    "node": "30",
    "input": "switch",
    "type": "enum",
    "options": [
     false,
     true
    ],
    "default": true,
    "label": "Clean up photo",
    "control": "seg",
    "labels": {
     "false": "Off",
     "true": "On"
    },
    "span2": true,
    "info": "On: the photo is cleaned up first (lighting removed, the object alone on a plain background) with Qwen Image Edit 2511, which gives Hunyuan3D a clearer shape. Off: the photo goes straight in (faster; fine for renders or studio shots)."
   },
   "lightning": {
    "node": "20",
    "input": "switch",
    "type": "enum",
    "options": [
     false,
     true
    ],
    "default": true,
    "label": "Lightning",
    "control": "seg",
    "labels": {
     "false": "Off",
     "true": "On"
    },
    "span2": true,
    "info": "Lightning is a speed-up add-on (a LoRA). On (the default): about 4 steps at guidance 1, a few seconds per image. Off: the full model, 20-50 steps; Guidance and the negative prompt only take effect when it is off.",
    "when": {
     "param": "cleanup",
     "is": true
    }
   },
   "removeBg": {
    "node": "m25",
    "input": "switch",
    "type": "enum",
    "options": [
     false,
     true
    ],
    "default": true,
    "label": "Remove background",
    "control": "seg",
    "labels": {
     "false": "Off",
     "true": "On"
    },
    "span2": true,
    "info": "Cuts the object out of its background first (BiRefNet), so a photo or render on any backdrop works. Turn it off only if the picture already shows the object on a plain background."
   },
   "steps": {
    "node": "m19:7",
    "input": "steps",
    "type": "int",
    "min": 10,
    "max": 50,
    "default": 30,
    "label": "Steps",
    "control": "stepper",
    "step": 5,
    "info": "How many refinement passes when building the shape. 30 is the default; fewer is faster but less accurate."
   },
   "cfg": {
    "node": "m19:7",
    "input": "cfg",
    "type": "number",
    "min": 1,
    "max": 10,
    "step": 0.5,
    "default": 5,
    "label": "Guidance",
    "control": "slider",
    "info": "How closely the shape follows the picture. 5 is the default; very high values can make the shape noisy."
   },
   "detail": {
    "node": "m19:8",
    "input": "octree_resolution",
    "type": "enum",
    "options": [
     192,
     256,
     320,
     384
    ],
    "default": 256,
    "label": "Detail",
    "control": "select",
    "group": "Shape",
    "info": "Resolution of the 3D grid the surface is taken from. Higher captures finer detail but is slower and needs more memory."
   },
   "surface": {
    "node": "m19:9",
    "input": "threshold",
    "type": "number",
    "min": 0.3,
    "max": 0.9,
    "step": 0.05,
    "default": 0.6,
    "label": "Surface level",
    "control": "slider",
    "info": "Where the surface is placed in the model's 3D density. Lower makes the shape fuller and thicker; higher makes it thinner and can open holes. 0.6 is the default."
   },
   "method": {
    "node": "m19:9",
    "input": "algorithm",
    "type": "enum",
    "options": [
     "surface net",
     "basic"
    ],
    "default": "surface net",
    "label": "Surface method",
    "control": "select",
    "info": "How the 3D grid is turned into a mesh. \"surface net\" gives smooth surfaces; \"basic\" gives a blocky, voxel look."
   },
   "faces": {
    "node": "m26",
    "input": "target_face_count",
    "type": "int",
    "min": 20000,
    "max": 520000,
    "step": 20000,
    "default": 520000,
    "label": "Max faces",
    "control": "slider",
    "format": "k",
    "zeroAtMax": true,
    "info": "Upper limit on the number of triangles; the mesh is simplified down to this. At the top of the slider (Full) nothing is removed."
   }
  },
  "maxBatch": 1,
  "vram": {
   "estMB": 16000,
   "basis": "Qwen Image Edit 2511 (as its preset), offloaded before Hunyuan3D 2.1 (~9 GB)"
  },
  "info": {
   "image": "A photo of one object, as much of it in view as possible (a three-quarter view shows the most shape). Take it with the + button or the Camera button.",
   "prompt": "Optional notes for the clean-up: what to keep or fix, e.g. \"remove the hand holding it\", \"keep the sticker on the side\". Leave empty to keep the object as it is."
  }
 },
